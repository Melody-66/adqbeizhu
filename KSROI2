// ==UserScript==
// @name         KS 自定义报表 ROI 高亮（支持翻页）
// @namespace    http://tampermonkey.net/
// @version      1.2
// @description  自动高亮全站直接ROI低于1的行，并在翻页/过滤/切换条数后自动刷新
// @match        https://luopan.e.kuaishou.com/analysis/custom-report-view*
// @updateURL    https://raw.githubusercontent.com/Melody-66/adqbeizhu/main/KSROI2
// @downloadURL  https://raw.githubusercontent.com/Melody-66/adqbeizhu/main/KSROI2
// @grant        none

(function () {
    'use strict';

    const ROI_HEADER = "全站直接ROI";
    const VIDEO_HEADER = "视频ID";
    const PLAN_HEADER = "广告计划";

    const today = new Date().toISOString().slice(0, 10);
    const STORE_KEY = "ks_video_checked_" + today;
    const checkedMap = JSON.parse(localStorage.getItem(STORE_KEY) || "{}");

    function saveStore() {
        localStorage.setItem(STORE_KEY, JSON.stringify(checkedMap));
    }

    function getTable() {
        return document.querySelector("table");
    }

    function findColIndex(headers, keyword) {
        for (let i = 0; i < headers.length; i++) {
            if (headers[i].innerText && headers[i].innerText.includes(keyword)) {
                return i;
            }
        }
        return -1;
    }

    function runLogic() {
        const table = getTable();
        if (!table) return;

        const headers = table.querySelectorAll("thead tr th");
        if (!headers.length) return;

        const roiIndex = findColIndex(headers, ROI_HEADER);
        const videoIndex = findColIndex(headers, VIDEO_HEADER);
        const planIndex = findColIndex(headers, PLAN_HEADER);

        if (roiIndex === -1 || videoIndex === -1 || planIndex === -1) return;

        const rows = table.querySelectorAll("tbody tr");

        rows.forEach(row => {
            const tds = row.querySelectorAll("td");
            if (!tds.length) return;

            const roiCell = tds[roiIndex];
            const videoCell = tds[videoIndex];
            const planCell = tds[planIndex];

            /* ================= ROI 高亮（独立逻辑） ================= */
            roiCell.removeAttribute("data-roi-marked");
            roiCell.style.backgroundColor = "";
            roiCell.style.color = "";
            roiCell.style.fontWeight = "";

            const roiVal = parseFloat(roiCell.innerText);
            if (!isNaN(roiVal) && roiVal < 1) {
                roiCell.style.backgroundColor = "rgba(255,0,0,0.25)";
                roiCell.style.color = "#b00000";
                roiCell.style.fontWeight = "bold";
                roiCell.setAttribute("data-roi-marked", "1");
            }

            /* ================= 视频勾选（不影响 ROI） ================= */
            const videoText = videoCell.innerText.trim();
            const planText = planCell.innerText.trim();
            const rowKey = videoText + "__" + planText;

            if (!videoCell.querySelector(".ks-video-check")) {
                const cb = document.createElement("input");
                cb.type = "checkbox";
                cb.className = "ks-video-check";
                cb.style.marginRight = "6px";
                cb.checked = !!checkedMap[rowKey];

                cb.addEventListener("change", () => {
                    if (cb.checked) {
                        checkedMap[rowKey] = 1;
                        videoCell.style.color = "#d60000";
                        videoCell.style.fontWeight = "bold";
                    } else {
                        delete checkedMap[rowKey];
                        videoCell.style.color = "";
                        videoCell.style.fontWeight = "";
                    }
                    saveStore();
                });

                videoCell.prepend(cb);
            }

            if (checkedMap[rowKey]) {
                videoCell.style.color = "#d60000";
                videoCell.style.fontWeight = "bold";
            }
        });
    }

    const observer = new MutationObserver(() => {
        runLogic();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

    (function waitInit() {
        if (getTable()) {
            runLogic();
        } else {
            requestAnimationFrame(waitInit);
        }
    })();

})();
